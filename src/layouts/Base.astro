---
// Label font: Inter, included in the site's own files.
import '@fontsource/inter/400.css';
import '@fontsource/inter/400-italic.css';
import '@fontsource/inter/600.css';
import '../styles/tokens.css';
import '../styles/global.css';
import { site } from '../config/site';

interface Props {
  title?: string;
  section?: 'home' | 'research' | 'design' | 'pedagogy' | 'lab'; // 'design' is the lavender section, used by the trial Practice page // the page's colour section
}
const { title, section = 'home' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const pageTitle = title ? `${title} | ${site.name}` : site.name;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <script is:inline>
      // Apply a saved light/dark choice before the page paints.
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
        const pr = localStorage.getItem('practice');
        if (pr && pr !== 'off') document.documentElement.dataset.practice = pr;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip mono" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell">
        <a class="site-name" href="/">{site.name}</a>
        <nav class="site-nav" aria-label="Primary">
          {
            site.nav.map((item) => (
              <a
                class="bracket"
                href={item.href}
                style={`--nav-color: var(--nav-${item.section})`}
                aria-current={path === item.href ? 'page' : undefined}
              >
                {item.label.toLowerCase()}
              </a>
            ))
          }
          {/* TRIAL: a fourth page, shown by the temporary switch below */}
          <a
            class="bracket practice-only"
            href="/practice"
            style="--nav-color: var(--nav-practice)"
            aria-current={path === '/practice' ? 'page' : undefined}
          >
            practice
          </a>
          <button class="bracket" type="button" id="practice-toggle" aria-label="Trial: add a Practice page, and choose its icon">
            practice: <span id="practice-state">off</span>
          </button>
          <button class="bracket" type="button" id="theme-toggle" aria-label="Switch between light and dark">
            light/dark
          </button>
        </nav>
      </div>
    </header>

    <main id="main" class="shell" data-section={section}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell">
        {
          site.footer.map((item) => (
            <a class="bracket" href={item.href}>
              <span class="k">{item.key}:</span> {item.text}
            </a>
          ))
        }
      </div>
    </footer>

    <script is:inline>
      // Trial switch for a fourth page, "Practice" (temporary). Cycles off, then each candidate icon.
      (() => {
        const root = document.documentElement;
        const order = ['off', 'd20', 'board', 'd6'];
        const label = document.getElementById('practice-state');
        const show = () => label && (label.textContent = root.dataset.practice || 'off');
        show();
        document.getElementById('practice-toggle')?.addEventListener('click', () => {
          const next = order[(order.indexOf(root.dataset.practice || 'off') + 1) % order.length];
          if (next === 'off') delete root.dataset.practice;
          else root.dataset.practice = next;
          show();
          try {
            localStorage.setItem('practice', next);
          } catch {}
        });
      })();

      // Light/dark switch. Dark is the default; light follows the system setting unless chosen here.
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark =
          root.dataset.theme === 'dark' ||
          (!root.dataset.theme && !matchMedia('(prefers-color-scheme: light)').matches);
        root.dataset.theme = dark ? 'light' : 'dark';
        try {
          localStorage.setItem('theme', root.dataset.theme);
        } catch {}
      });
    </script>
  </body>
</html>
