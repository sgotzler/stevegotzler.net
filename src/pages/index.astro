---
import Base from '../layouts/Base.astro';
// The drawn mark, placed inline so it takes the page's ink and accent colours. Candidates are in art/about.
import mark from '../assets/images/about.svg?raw';
// TRIAL: the five-space mark, shown when the temporary "practice" switch is on.
import markFive from '../assets/images/about-five.svg?raw';
import { site } from '../config/site';

// The CV row shows the file's own name as its link. The PDF itself goes in public/files.
const cvName = site.cv.split('/').pop();
---

<Base section="home">
  <div class="about">
    <div class="about-main">
      <header class="page-head">
        <h1>About</h1>
        <p class="lede wide">I study work and play, <br />and the technologies that organize them.</p>
      </header>
      <div class="about-body">
        <p>
          I am a Teaching Assistant Professor of English &amp; Comparative Literature at UNC Chapel Hill, where I
          direct the <a href="https://dlclab.unc.edu/">Digital Literacy and Communications (DLC) Lab</a> and the{' '}
          <a href="https://dlclab.unc.edu/gaming-program/">Critical Game Studies Program</a>. My courses range from horror fiction to tabletop game design, and in most of
          them students play, dismantle, and build games. I co-host{' '}
          <a href="https://www.subjectmattertabletop.org/"><em>Subject Matter: Table Top</em></a>, a podcast about board games and the
          subjects they take up, and design tabletop and art games of my own, as experiments in play as a form of inquiry.
          I also build small digital tools for reading and research, on the principle that understanding how they work
          clarifies the conditions of our labor.
        </p>
        <p>
          I trained in literary and cultural studies at Carnegie Mellon University, where my doctoral work drew
          together media history, digital humanities, and critical university studies. I grew up in California's high
          Mojave Desert, east of the Sierra Nevada near Death Valley, and spent my undergraduate years as a banana slug
          at UC Santa Cruz, majoring in American Studies.
        </p>
      </div>
    </div>

    <div class="about-side">
      <div class="about-mark mark-four" set:html={mark} />
      <div class="about-mark mark-five" set:html={markFive} />
      <dl class="fields">
      <dt>CV</dt>
      <dd><a href={site.cv}>{cvName}</a></dd>
      <dt>Email</dt>
      <dd><a href="mailto:sgotzler@unc.edu">sgotzler@unc.edu</a></dd>
      </dl>
    </div>
  </div>
</Base>
