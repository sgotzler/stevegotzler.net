---
import Base from '../layouts/Base.astro';
// The drawn mark, placed inline so it takes the page's ink and accent colours. Candidates are in art/about.
import mark from '../assets/images/about.svg?raw';
import { existsSync } from 'node:fs';
import { site } from '../config/site';

// The CV row shows the file's own name as its link once the PDF is in public/files; until then, "[to come]".
const cvName = site.cv.split('/').pop();
const cvReady = existsSync(`public${site.cv}`);

// The About page: the one page with a lede (the other pages go straight from label to index), then a short bio.
// FIRST DRAFT, deliberately long: to be cut back.
---

<Base section="home">
  <header class="page-head">
    <h1>About</h1>
    <p class="lede wide">I study work and play, <br />and the technologies that organize them.</p>
  </header>

  <div class="about">
    <div class="about-body">
      <p>
        I am a Teaching Assistant Professor in the Department of English &amp; Comparative Literature at the University
        of North Carolina at Chapel Hill, where I direct the Digital Literacy and Communications (DLC) Lab and the
        Critical Game Studies Program. My <a href="/research">research</a> explores historical regimes of labor and
        work, cultural studies of games and play, and materialist theories of media and technology.
      </p>
      <p>
        I am at work on two books: <em>Working Models</em>, a study of how games model work, and{' '}
        <em>Terminal Degree</em>, a history of computing and the public university co-authored with Avery J. Wiscomb. I
        teach <a href="/pedagogy">courses</a> at the intersection of literature, film, and game studies, convene the
        Carolina Seminar in Critical Game Studies at the <a href="/lab">lab</a>, and co-host the podcast{' '}
        <em>Subject Matter: Table Top</em>.
      </p>
    </div>

    <div class="about-side">
      <div class="about-mark" role="img" aria-label="A diagram of worker placement. Three workers wait in a supply; a fourth has been placed on the last of four action spaces. The first three spaces stand for the Research, Pedagogy and Lab pages, and the placed worker for this page." set:html={mark} />
      <dl class="fields">
      <dt>CV</dt>
      <dd class:list={{ muted: !cvReady }}>{cvReady ? <a href={site.cv}>{cvName}</a> : '[to come]'}</dd>
      <dt>Email</dt>
      <dd><a href="mailto:sgotzler@unc.edu">sgotzler@unc.edu</a></dd>
      </dl>
    </div>
  </div>
</Base>
