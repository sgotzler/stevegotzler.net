---
// TRIAL: three layouts for Student Work, side by side for comparison. Not linked from anywhere; delete once one is chosen.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import { inline } from '../lib/text';

const groups = (await getCollection('studentwork')).sort((a, b) => a.data.order - b.data.order);
const plain = (t: string) => t.replaceAll('*', '');
---

<Base title="Student Work, three layouts" section="pedagogy">
  <header class="page-head">
    <h1>Trial · Student Work</h1>
    <nav class="page-index mono" aria-label="On this page">
      <a href="#one"><span class="n">01</span>Diptych</a>
      <a href="#two"><span class="n">02</span>Image beside each row</a>
      <a href="#two-b"><span class="n">02b</span>Larger image beside each row</a>
      <a href="#three"><span class="n">03</span>Full-width rows</a>
      <a href="#three-b"><span class="n">03b</span>Full-width rows, headed groups</a>
    </nav>
  </header>

  <!-- 1 · Diptych: two images across the top of each plate, rows below -->
  <section class="section" id="one">
    <div class="section-head"><span class="n">01</span><h2>Diptych</h2></div>
    <div class="catalogue two">
      {
        groups.map((g) => (
          <article class="plate project">
            <div class="sw-diptych">
              {g.data.assignments.map((a) => (
                <figure>
                  <Placeholder note={`still from ${plain(a.title)}`} />
                  <figcaption set:html={inline(a.title)} />
                </figure>
              ))}
            </div>
            <div class="inner">
              <div class="plate-meta"><span>{g.data.courses}</span></div>
              <h3 class="plate-title" set:html={inline(g.data.title)} />
              <div class="events open assignments">
                <ol>
                  {g.data.assignments.map((a) => (
                    <li>
                      <span class="when">{a.course}{a.courseNote && <span class="course-note">{a.courseNote}</span>}</span>
                      <span>
                        <Fragment set:html={inline(a.title)} />
                        <span class="who" set:html={inline(a.line)} />
                      </span>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- 2 · An image beside each assignment, like an index card -->
  <section class="section" id="two">
    <div class="section-head"><span class="n">02</span><h2>Image beside each row</h2></div>
    <div class="catalogue two">
      {
        groups.map((g) => (
          <article class="plate">
            <div class="plate-meta"><span>{g.data.courses}</span></div>
            <h3 class="plate-title" set:html={inline(g.data.title)} />
            <ol class="sw-cards">
              {g.data.assignments.map((a) => (
                <li>
                  <Placeholder note={`still from ${plain(a.title)}`} />
                  <div>
                    <p class="sw-course">{a.course}{a.courseNote && ` ${a.courseNote}`}</p>
                    <p class="sw-title" set:html={inline(a.title)} />
                    <p class="sw-line" set:html={inline(a.line)} />
                  </div>
                </li>
              ))}
            </ol>
          </article>
        ))
      }
    </div>
  </section>

  <!-- 2b · The same, with the image at about two-fifths of the plate -->
  <section class="section" id="two-b">
    <div class="section-head"><span class="n">02b</span><h2>Larger image beside each row</h2></div>
    <div class="catalogue two">
      {
        groups.map((g) => (
          <article class="plate">
            <div class="plate-meta"><span>{g.data.courses}</span></div>
            <h3 class="plate-title" set:html={inline(g.data.title)} />
            <ol class="sw-cards large">
              {g.data.assignments.map((a) => (
                <li>
                  <Placeholder note={`still from ${plain(a.title)}`} />
                  <div>
                    <p class="sw-course">{a.course}{a.courseNote && ` ${a.courseNote}`}</p>
                    <p class="sw-title" set:html={inline(a.title)} />
                    <p class="sw-line" set:html={inline(a.line)} />
                  </div>
                </li>
              ))}
            </ol>
          </article>
        ))
      }
    </div>
  </section>

  <!-- 3 · Each assignment across the page, grouped under small headings -->
  <section class="section" id="three">
    <div class="section-head"><span class="n">03</span><h2>Full-width rows</h2></div>
    {
      groups.map((g) => (
        <>
          <h3 class="subhead" set:html={inline(g.data.title)} />
          <div class="catalogue across sw-across">
            {g.data.assignments.map((a) => (
              <article class="plate project">
                <Placeholder note={`still from ${plain(a.title)}`} />
                <div class="inner">
                  <div class="plate-meta"><span>{a.course}{a.courseNote && ` ${a.courseNote}`}</span></div>
                  <h3 class="plate-title" set:html={inline(a.title)} />
                  <p class="desc" set:html={inline(a.line)} />
                </div>
              </article>
            ))}
          </div>
        </>
      ))
    }
  </section>
  <!-- 3b · Full-width rows under real group headings; video-shaped images; one frame per group -->
  <section class="section" id="three-b">
    <div class="section-head"><span class="n">03b</span><h2>Full-width rows, headed groups</h2></div>
    {
      groups.map((g) => (
        <div class="sw-group">
          <h3 class="sw-group-title" set:html={inline(g.data.title)} />
          <div class="sw-group-rows">
            {g.data.assignments.map((a) => (
              <article class="sw-row">
                <Placeholder note={`still from ${plain(a.title)}`} />
                <div>
                  <p class="sw-course sw-kicker">{a.course}{a.courseNote && ` ${a.courseNote}`}</p>
                  <p class="sw-row-title" set:html={inline(a.title)} />
                  <p class="desc" set:html={inline(a.line)} />
                </div>
              </article>
            ))}
          </div>
        </div>
      ))
    }
  </section>
</Base>
