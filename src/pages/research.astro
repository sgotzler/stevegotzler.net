---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageMark from '../components/PageMark.astro';
import Carousel from '../components/Carousel.astro';
import Feature from '../components/Feature.astro';
import Figure from '../components/Figure.astro';
import VenueLine from '../components/VenueLine.astro';
import WritingPlate from '../components/WritingPlate.astro';
import { inline, LOREM } from '../lib/text';

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order;
const newestFirst = (a: { data: { sort: string } }, b: { data: { sort: string } }) =>
  b.data.sort.localeCompare(a.data.sort);

const books = (await getCollection('books')).sort(byOrder);
const podcast = (await getCollection('podcast')).sort(byOrder);
const design = (await getCollection('design')).sort(byOrder);
const pastwork = (await getCollection('pastwork')).sort(byOrder);
const writing = (await getCollection('writing')).sort(newestFirst);

const publications = writing.filter((e) => e.data.kind === 'publication');
const talks = writing.filter((e) => e.data.kind === 'talk');
const linkedTo = (id: string) => writing.filter((e) => e.data.linkedTo === id);


const sections = [
  { id: 'books', label: 'Books' },
  { id: 'writing-and-talks', label: 'Writing and Talks' },
  { id: 'games', label: 'Games' },
  { id: 'podcast', label: 'Podcast' },
  { id: 'past-work', label: 'Past Work' },
];
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<Base title="Research" section="research">
  <header class="page-head">
    <PageMark section="research" />
    <h1>Research</h1>
    <nav class="page-index mono" aria-label="On this page">
      {
        sections.map((s, i) => (
          <a href={`#${s.id}`}>
            <span class="n">{num(i)}</span>
            {s.label}
          </a>
        ))
      }
    </nav>
  </header>

  <section class="section" id="books">
    <div class="section-head">
      <span class="n">01</span>
      <h2>Books</h2>
    </div>
    {books.map((b) => <Feature entry={b} linked={linkedTo(b.id)} />)}
  </section>

  <section class="section" id="writing-and-talks">
    <div class="section-head">
      <span class="n">02</span>
      <h2>Writing and Talks</h2>
    </div>

    <h3 class="subhead">Publications</h3>
    <div class="catalogue">
      {
        publications.map((e) => (
          <WritingPlate entry={e} />
        ))
      }
    </div>

    <h3 class="subhead">Talks</h3>
    <div class="catalogue">
      {
        talks.map((e) => (
          <WritingPlate entry={e} />
        ))
      }
    </div>
  </section>

  <section class="section" id="games">
    <div class="section-head">
      <span class="n">03</span>
      <h2>Games</h2>
    </div>
    <div class="catalogue two">
      {
        design.map((g) => (
          <article class="plate project" id={g.id}>
            <Carousel id={g.id} count={g.data.slides} alt={g.data.imageAlt} note={g.data.imageNote} label={g.data.title} />
            <div class="inner">
              <div class="plate-meta">
                <span>{g.data.status}</span>
              </div>
              <h3 class="plate-title" set:html={inline(g.data.title)} />
              <p class="desc">{LOREM[0]}</p>
              <dl class="fields">
                <dt>Form</dt>
                <dd set:html={inline(g.data.form)} />
                {g.data.grounding && (
                  <>
                    <dt>Draws on</dt>
                    <dd set:html={inline(g.data.grounding)} />
                  </>
                )}
              </dl>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section" id="podcast">
    <div class="section-head">
      <span class="n">04</span>
      <h2>Podcast</h2>
    </div>
    {podcast.map((p) => <Feature entry={p} linked={linkedTo(p.id)} />)}
  </section>

  <section class="section" id="past-work">
    <div class="section-head">
      <span class="n">05</span>
      <h2>Past Work</h2>
    </div>
    <div class="catalogue wide">
      {
        pastwork.map((p) => (
          <article class="plate project" id={p.id}>
            <Figure id={p.id} alt={p.data.imageAlt} note={p.data.imageNote} />
            <div class="inner">
              <div class="plate-meta">
                <span>{p.data.years}</span>
                <span>{p.data.type}</span>
              </div>
              <h3 class="plate-title" set:html={inline(p.data.title)} />
              <p class="desc" set:html={inline(p.data.description)} />
              <dl class="fields">
                {p.data.collaborators.length > 0 && (
                  <>
                    <dt>With</dt>
                    <dd>{p.data.collaborators.join(', ')}</dd>
                  </>
                )}
                <VenueLine entries={linkedTo(p.id)} />
                {p.data.funding && (
                  <>
                    <dt>Funding</dt>
                    <dd>{p.data.funding}</dd>
                  </>
                )}
                {p.data.link && (
                  <>
                    <dt>Visit</dt>
                    <dd>
                      <a href={p.data.link}>{p.data.linkLabel ?? p.data.link}</a>
                    </dd>
                  </>
                )}
                {p.data.repo && (
                  <>
                    <dt>Code</dt>
                    <dd>
                      <a href={p.data.repo}>{p.data.repo.replace('https://github.com/', '')}</a>
                    </dd>
                  </>
                )}
              </dl>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Base>
