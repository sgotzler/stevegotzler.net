---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Events from '../components/Events.astro';
import Figure from '../components/Figure.astro';
import { inline } from '../lib/text';

const entries = (await getCollection('lab')).sort((a, b) => a.data.order - b.data.order);
const top = entries.filter((e) => e.data.kind === 'feature' || e.data.kind === 'child');
const seminar = entries.filter((e) => e.data.kind === 'seminar');
// Entries of kind `partnership` stay in lab.yaml but are not shown on the page.
const host = (url: string) => url.replace('https://', '').replace(/\/$/, '');
const kicker = (d: { role?: string; years?: string }) => [d.role, d.years].filter(Boolean).join(' · ');
---

<Base title="Lab" section="lab">
  <header class="page-head">
    <h1>Lab</h1>
    <nav class="page-index mono" aria-label="On this page">
      <a href="#lab"><span class="n">01</span>DLC Lab</a>
      <a href="#carolina-seminar-section"><span class="n">02</span>Carolina Seminar</a>
    </nav>
  </header>

  <section class="section" id="lab">
    <div class="section-head">
      <span class="n">01</span>
      <h2>DLC Lab</h2>
    </div>
    {
      top.map((e) => (
        <article class:list={['feature', { paired: e.data.kind === 'child' }]} id={e.id}>
          <Figure id={e.id} alt={e.data.imageAlt} note={e.data.imageNote} />
          <div>
            <p class="kicker">{kicker(e.data)}</p>
            <h3 set:html={inline(e.data.name)} />
            {e.data.subtitle && <p class="sub" set:html={inline(e.data.subtitle)} />}
            <div class="body">
              <p set:html={inline(e.data.description)} />
            </div>
            <dl class="fields">
              {e.data.roles.length > 0 && (
                <>
                  <dt>Role</dt>
                  <dd>{e.data.roles.join(', ')}</dd>
                </>
              )}
              {e.data.institutions && (
                <>
                  <dt>With</dt>
                  <dd>{e.data.institutions}</dd>
                </>
              )}
              {e.data.link && (
                <>
                  <dt>Visit</dt>
                  <dd>
                    <a href={e.data.link}>{e.data.linkLabel ?? host(e.data.link)}</a>
                  </dd>
                </>
              )}
            </dl>
          </div>
        </article>
      ))
    }
  </section>

  <section class="section" id="carolina-seminar-section">
    <div class="section-head">
      <span class="n">02</span>
      <h2>Carolina Seminar</h2>
    </div>
    {
      seminar.map((e) => (
        <article class="feature" id={e.id}>
          <Figure id={e.id} alt={e.data.imageAlt} note={e.data.imageNote} />
          <div>
            <p class="kicker">{kicker(e.data)}</p>
            <h3 set:html={inline(e.data.name)} />
            {e.data.subtitle && <p class="sub" set:html={inline(e.data.subtitle)} />}
            <div class="body">
              <p set:html={inline(e.data.description)} />
            </div>
            <dl class="fields">
              {e.data.institutions && (
                <>
                  <dt>With</dt>
                  <dd>{e.data.institutions}</dd>
                </>
              )}
              {e.data.link && (
                <>
                  <dt>Visit</dt>
                  <dd>
                    <a href={e.data.link}>{e.data.linkLabel ?? host(e.data.link)}</a>
                  </dd>
                </>
              )}
            </dl>
            <Events events={e.data.events} />
          </div>
        </article>
      ))
    }
  </section>
</Base>
