---
// A page's own action space from the worker placement mark on About: the same icon, in the page's colour.
// Decorative: the page label beside it already names the page.
interface Props {
  section: 'research' | 'pedagogy' | 'lab' | 'practice';
}
const { section } = Astro.props;
// TRIAL: the Practice page has three candidate icons; the header switch picks one.
const practiceIcons = {
  d20: '<path d="M0.00 -8.50L7.36 -4.25L7.36 4.25L0.00 8.50L-7.36 4.25L-7.36 -4.25z"/><path d="M0.00 -4.20L4.60 3.60L-4.60 3.60zM0 -4.2L0.00 -8.50M0 -4.2L7.36 -4.25M0 -4.2L-7.36 -4.25M4.6 3.6L7.36 -4.25M4.6 3.6L7.36 4.25M4.6 3.6L0.00 8.50M-4.6 3.6L0.00 8.50M-4.6 3.6L-7.36 4.25M-4.6 3.6L-7.36 -4.25" stroke-width="1"/>',
  board: '<rect x="-9" y="-8" width="18" height="16" rx="1"/><rect x="-5" y="-4" width="10" height="8" stroke-width="1"/><path d="M-5 -8v4M-5 4v4M-1.7 -8v4M-1.7 4v4M1.7 -8v4M1.7 4v4M5 -8v4M5 4v4M-9 -4h4M5 -4h4M-9 0h4M5 0h4M-9 4h4M5 4h4" stroke-width="1"/><circle cx="3.3" cy="-6" r="1.4" fill="currentColor" stroke="none"/>',
  d6: '<rect x="-7" y="-7" width="14" height="14" rx="2.5"/><g fill="currentColor" stroke="none"><circle cx="-3.3" cy="-3.3" r="1.2"/><circle r="1.2"/><circle cx="3.3" cy="3.3" r="1.2"/></g>',
};
const icons = {
  practice: '',
  research: '<path d="M-7 -5h14M-7 0h14M-7 5h9"/>',
  pedagogy:
    '<path d="M-5.8 -4.2h11.6c2.3 0 3.5 1.6 3.8 4.1l.6 4.3c.3 2-2 2.8-3.1 1.1l-1.6-2.4h-11l-1.6 2.4c-1.1 1.7-3.4.9-3.1-1.1l.6-4.3c.3-2.5 1.5-4.1 3.8-4.1z"/><path d="M-5.6 -.2h3.2M-4 -1.8v3.2" stroke-width="1.1"/><circle cx="3.2" cy=".5" r=".85" fill="currentColor" stroke="none"/><circle cx="5.3" cy="-1.3" r=".85" fill="currentColor" stroke="none"/>',
  lab: '<rect x="-9" y="-7.5" width="18" height="15" rx="1.5"/><path d="M-5.5 -3l3.5 3-3.5 3M0 3.5h5"/>',
};
---

<svg
  class="page-mark"
  viewBox="-15 -18 30 36"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <rect x="-14" y="-17" width="28" height="34" rx="4"></rect>
  {section !== 'practice' && <g class="icon" stroke-width="1.3" set:html={icons[section]} />}
  {section === 'practice' &&
    Object.entries(practiceIcons).map(([k, v]) => (
      <g class={`icon practice-icon practice-icon-${k}`} stroke-width="1.3" set:html={v} />
    ))}
</svg>
